# ============================================================
#  BookIt – Docker environment configuration
#  Fill in your values, then start with:
#  docker compose --env-file .env.docker up -d
# ============================================================

# ── Auth (REQUIRED) ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ── Email notifications (leave SMTP_HOST blank to disable) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=BookIt

# ── SMS notifications (leave TWILIO_ACCOUNT_SID blank to disable) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ── Optional ────────────────────────────────────────────────
# PORT=3000
# DB_ROOT_PASSWORD=rootsecret

# ── HTTPS (self-signed or real cert) ────────────────────────
# Place cert.pem and key.pem in a ./certs/ folder, then set:
# HTTPS_PORT=3443
# SSL_CERT=/app/certs/cert.pem
# SSL_KEY=/app/certs/key.pem
